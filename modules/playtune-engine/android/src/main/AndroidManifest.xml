<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Scan songs: Android 13+ / Android 12 and older -->
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

  <!-- Keep playing in the background -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- Notifications (Android 13+) -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Equalizer / bass boost / virtualizer -->
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

  <application>
    <service
      android:name="expo.modules.playtuneengine.PlaybackService"
      android:exported="true"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaSessionService" />
      </intent-filter>
    </service>

    <!-- Home-screen widget (4×2): artwork, title, artist, previous / play-pause / next -->
    <receiver
      android:name="expo.modules.playtuneengine.PlaytuneWidget"
      android:exported="false"
      android:label="@string/pt_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/pt_widget_info" />
    </receiver>
  </application>

</manifest>
