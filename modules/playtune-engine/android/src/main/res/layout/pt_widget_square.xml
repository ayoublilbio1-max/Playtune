<?xml version="1.0" encoding="utf-8"?>
<!-- Playtune square widget (2×2): cover / disc logo + play-pause, title, artist + next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/pt_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/pt_widget_bg"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/pt_widget_art"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/pt_disc_logo" />

      <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

      <ImageButton
        android:id="@+id/pt_widget_play"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/pt_widget_play_bg"
        android:contentDescription="@string/pt_widget_play"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_pt_widget_play" />
    </LinearLayout>

    <TextView
      android:id="@+id/pt_widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="@string/pt_widget_label"
      android:textColor="@color/pt_widget_text"
      android:textSize="14sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/pt_widget_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/pt_widget_empty"
        android:textColor="@color/pt_widget_text_muted"
        android:textSize="12sp" />

      <ImageButton
        android:id="@+id/pt_widget_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/pt_widget_btn_bg"
        android:contentDescription="@string/pt_widget_next"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_pt_widget_next" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
