<?xml version="1.0" encoding="utf-8"?>
<!-- Playtune home-screen widget (4×2): cover / disc logo · brand / title / artist · previous, play-pause, next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/pt_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/pt_widget_bg"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

      <ImageView
        android:id="@+id/pt_widget_art"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/pt_disc_logo" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="14dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.18"
        android:text="@string/pt_widget_brand"
        android:textColor="@color/pt_widget_accent"
        android:textSize="10sp" />

      <TextView
        android:id="@+id/pt_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/pt_widget_label"
        android:textColor="@color/pt_widget_text"
        android:textSize="16sp" />

      <TextView
        android:id="@+id/pt_widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/pt_widget_empty"
        android:textColor="@color/pt_widget_text_muted"
        android:textSize="13sp" />

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
          android:id="@+id/pt_widget_prev"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="@drawable/pt_widget_btn_bg"
          android:contentDescription="@string/pt_widget_previous"
          android:padding="10dp"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_pt_widget_prev" />

        <ImageButton
          android:id="@+id/pt_widget_play"
          android:layout_width="50dp"
          android:layout_height="50dp"
          android:layout_marginStart="12dp"
          android:layout_marginEnd="12dp"
          android:background="@drawable/pt_widget_play_bg"
          android:contentDescription="@string/pt_widget_play"
          android:padding="13dp"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_pt_widget_play" />

        <ImageButton
          android:id="@+id/pt_widget_next"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="@drawable/pt_widget_btn_bg"
          android:contentDescription="@string/pt_widget_next"
          android:padding="10dp"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_pt_widget_next" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
